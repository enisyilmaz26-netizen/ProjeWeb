VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (opsiyonel)
# Runtime'da tarayıcıya expose edilir — public olmasında sakınca yok (Sentry DSN'leri tasarımca public).
# Boş bırakılırsa Sentry init no-op olur; production build'de hiçbir hata gönderilmez.
VITE_SENTRY_DSN=

# Build-time only. ASLA commit etme.
# Üçü birden set edilmediği sürece source map upload atlanır (build yine çalışır).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
